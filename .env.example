# 复制为 .env 后按需修改。docker compose 会自动读取该文件做变量替换。

# ----- 部署模式（本地默认，一般无需修改）-----
# 本地：COMPOSE_PROFILES=with-mysql,with-graph
# 阿里云单机：使用 .env.prod.example → docker compose --env-file .env.prod up -d --build
# 阿里云共享 MySQL：使用 .env.shared.example → docker compose --env-file .env.shared up -d --build
COMPOSE_PROFILES=with-mysql,with-graph
APP_ENV=development
SHARED_INFRA_EXTERNAL=false
MYSQL_HOST=mysql
MYSQL_USER=root
NEO4J_REQUIRED=true

# ----- 方案 A：本机 Ollama（当前默认，对应 LLM_MODEL=qwen3.6-plus）-----
# 1. ollama pull qwen3:latest
# 2. ollama cp qwen3:latest qwen3.6-plus
# 3. ollama pull nomic-embed-text
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
DOCKER_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3.6-plus
LLM_TEMPERATURE=0.2
LLM_REASONING=false
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=0

# ----- 方案 B：阿里云 MaaS（云端 qwen3.6-plus + text-embedding-v4）-----
# 使用方案 B 时请注释掉方案 A，并填写真实 Key：
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://llm-ddxbqu7e4h6kc0lq.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen3.6-plus
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSIONS=2048

# 数据库与图谱（首次初始化后不要随意改密码，除非同时删除对应数据卷）
MYSQL_ROOT_PASSWORD=123456
MYSQL_PASSWORD=123456
NEO4J_PASSWORD=12345678

# JWT 密钥，生产环境请改为随机长字符串
JWT_SECRET_KEY=ai-medical-consult-secret-key-2026
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174
# 微信小程序（不填则仅开发模拟登录 WECHAT_DEV_LOGIN=true 可用）
WECHAT_MINI_APPID=wx9d427f2699c9b2d0
WECHAT_MINI_SECRET=
# 未配置 Secret 时，开发者工具 mock code（the code is a mock one）会登录演示患者
WECHAT_DEV_LOGIN=true
ROOT_ADMIN_USERNAME=admin
ROOT_ADMIN_PASSWORD=change-this-local-admin-password
SEED_DEMO=true
DEMO_PASSWORD=change-this-demo-password
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=120
SSE_HEARTBEAT_SECONDS=15
SSE_MAX_SECONDS=300
VECTOR_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
RERANKER_URL=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
OTEL_EXPORTER_OTLP_ENDPOINT=

# 首次启动是否导入 Neo4j 图谱 / 是否向量化 docs_seed 知识库
INIT_GRAPH=true
INIT_KNOWLEDGE=false

# 宿主机端口（MYSQL_PORT 等仅主机侧端口；也可用 MYSQL_PUBLISH=127.0.0.1:3308:3306 完整映射）
WEB_PORT=80
BACKEND_PORT=8000
MYSQL_PORT=3308
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
