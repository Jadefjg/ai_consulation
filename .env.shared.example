# 阿里云共享 MySQL 模式（接入 shared-infra 网络中的 shared-mysql）
# 用法：docker compose --env-file .env.shared up -d --build
# 前置：宿主机已存在 docker network create shared-infra 及 shared-mysql 容器

# 不启动内置 MySQL。2C2G 同机部署务必留空，不要写 with-graph（Neo4j 会 OOM）。
# 需要图谱时再设 COMPOSE_PROFILES=with-graph，并先停同机其它重服务。
COMPOSE_PROFILES=
# 2C2G 建议保持 development，避免生产校验拦截共享库短密码。
# 若改为 production：MYSQL_PASSWORD 不能是 123456/password/root，JWT 也不能用默认值。
APP_ENV=development

OPENAI_API_KEY=ollama
DOCKER_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3.6-plus
EMBEDDING_MODEL=nomic-embed-text

MYSQL_ROOT_PASSWORD=
NEO4J_PASSWORD=
# 必须 >=32 位 ASCII 随机串。禁止中文占位（如「请修改为随机长字符串」），否则后端会直接退出。
# 生产环境禁止使用 ai-medical-consult-secret-key-2026
JWT_SECRET_KEY=
CORS_ORIGINS=https://www.wfrz.fun,https://wfrz.fun
WECHAT_MINI_APPID=wx9d427f2699c9b2d0
WECHAT_MINI_SECRET=7026973e5bc39107a1c5312935d1e9d7
WECHAT_DEV_LOGIN=false
ROOT_ADMIN_USERNAME=admin
ROOT_ADMIN_PASSWORD=
SEED_DEMO=false
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=120
SSE_HEARTBEAT_SECONDS=15
SSE_MAX_SECONDS=300

INIT_GRAPH=true
INIT_KNOWLEDGE=false

WEB_PORT=9000
BACKEND_PUBLISH=127.0.0.1:8001:8000
NEO4J_HTTP_PUBLISH=127.0.0.1:7474:7474
NEO4J_BOLT_PUBLISH=127.0.0.1:7687:7687

# 连接共享 MySQL（非容器内 mysql 服务名）
MYSQL_HOST=shared-mysql
MYSQL_SERVICE_PORT=3306
MYSQL_USER=medical
MYSQL_PASSWORD=
NEO4J_REQUIRED=false

# 使用外部 shared-infra 网络
SHARED_INFRA_EXTERNAL=true

# 低配内存（与历史 docker-compose.shared.yml 一致）
NEO4J_HEAP_INITIAL=64m
NEO4J_HEAP_MAX=128m
NEO4J_PAGECACHE=16m
NEO4J_JVM_ADDITIONAL=-XX:MaxMetaspaceSize=64m -XX:ReservedCodeCacheSize=24m -Xss256k
NEO4J_MEM_LIMIT=260m
NEO4J_MEMSWAP_LIMIT=720m

BACKEND_MEM_LIMIT=360m
BACKEND_MEMSWAP_LIMIT=720m
BACKEND_HEALTH_START=420s
BACKEND_HEALTH_RETRIES=30
VECTOR_WORKER_MEM_LIMIT=280m
SCHEDULER_WORKER_MEM_LIMIT=192m

FRONTEND_MEM_LIMIT=48m
FRONTEND_MEMSWAP_LIMIT=96m

PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
