# 阿里云共享 MySQL 模式（接入 shared-infra 网络中的 shared-mysql）
# 用法：docker compose --env-file .env.shared up -d --build
# 前置：宿主机已存在 docker network create shared-infra 及 shared-mysql 容器

# 不启动内置 MySQL；Neo4j 可选（需要图谱时保留 with-graph）
COMPOSE_PROFILES=with-graph

OPENAI_API_KEY=ollama
DOCKER_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3.6-plus
EMBEDDING_MODEL=nomic-embed-text

MYSQL_ROOT_PASSWORD=与共享库 medical 用户密码一致
NEO4J_PASSWORD=请修改
JWT_SECRET_KEY=请修改为随机长字符串

INIT_GRAPH=true
INIT_KNOWLEDGE=false

WEB_PORT=9000
BACKEND_PUBLISH=127.0.0.1:8001:8000
NEO4J_HTTP_PUBLISH=127.0.0.1:7474:7474
NEO4J_BOLT_PUBLISH=127.0.0.1:7687:7687

# 连接共享 MySQL（非容器内 mysql 服务名）
MYSQL_HOST=shared-mysql
MYSQL_SERVICE_PORT=3306
MYSQL_USER=medical
MYSQL_PASSWORD=与共享库一致
NEO4J_REQUIRED=false

# 使用外部 shared-infra 网络
SHARED_INFRA_EXTERNAL=true

# 低配内存（与历史 docker-compose.shared.yml 一致）
NEO4J_HEAP_INITIAL=64m
NEO4J_HEAP_MAX=128m
NEO4J_PAGECACHE=16m
NEO4J_JVM_ADDITIONAL=-XX:MaxMetaspaceSize=64m -XX:ReservedCodeCacheSize=24m -Xss256k
NEO4J_MEM_LIMIT=260m
NEO4J_MEMSWAP_LIMIT=720m

BACKEND_MEM_LIMIT=360m
BACKEND_MEMSWAP_LIMIT=720m
BACKEND_HEALTH_START=420s
BACKEND_HEALTH_RETRIES=30

FRONTEND_MEM_LIMIT=48m
FRONTEND_MEMSWAP_LIMIT=96m

PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
