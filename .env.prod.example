# 阿里云单机生产环境（2C2G 等低配 ECS）
# 用法：docker compose --env-file .env.prod up -d --build
# 说明：复制为 .env.prod 后按需修改密码与 API Key；勿提交真实密钥到 Git。

COMPOSE_PROFILES=with-mysql,with-graph

# ----- AI（按需选择 Ollama 或 MaaS，与 .env.example 相同）-----
OPENAI_API_KEY=ollama
DOCKER_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3.6-plus
EMBEDDING_MODEL=nomic-embed-text

# ----- 数据库 -----
MYSQL_ROOT_PASSWORD=请修改为强密码
NEO4J_PASSWORD=请修改为强密码
JWT_SECRET_KEY=请修改为随机长字符串

INIT_GRAPH=true
INIT_KNOWLEDGE=false

# ----- 端口（仅本机回环，公网只暴露前端 WEB_PORT）-----
WEB_PORT=9000
BACKEND_PUBLISH=127.0.0.1:8001:8000
MYSQL_PUBLISH=127.0.0.1:3308:3306
NEO4J_HTTP_PUBLISH=127.0.0.1:7474:7474
NEO4J_BOLT_PUBLISH=127.0.0.1:7687:7687

# ----- 内存限制（允许 swap）-----
MYSQL_MEM_LIMIT=256m
MYSQL_MEMSWAP_LIMIT=512m
MYSQL_INNODB_BUFFER_POOL=96M

NEO4J_HEAP_INITIAL=128m
NEO4J_HEAP_MAX=192m
NEO4J_PAGECACHE=48m
NEO4J_MEM_LIMIT=480m
NEO4J_MEMSWAP_LIMIT=960m
NEO4J_HEALTH_START=90s

BACKEND_MEM_LIMIT=448m
BACKEND_MEMSWAP_LIMIT=896m
BACKEND_HEALTH_START=420s
BACKEND_HEALTH_RETRIES=30

FRONTEND_MEM_LIMIT=64m
FRONTEND_MEMSWAP_LIMIT=128m

# ----- 国内镜像加速 -----
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# ----- 中间件（单机模式）-----
MYSQL_HOST=mysql
MYSQL_USER=root
NEO4J_REQUIRED=true
SHARED_INFRA_EXTERNAL=false
